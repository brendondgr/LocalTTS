# Copied to ~/.config/localtts/localtts.env by install.sh. Uncomment to override;
# then `localtts restart`.

# LOCALTTS_HOST=127.0.0.1          # 0.0.0.0 to reach it from other machines (no auth!)
# LOCALTTS_PORT=5040
# LOCALTTS_IDLE_UNLOAD_S=600       # unload an engine from the GPU after this long unused
# LOCALTTS_PRELOAD=                # e.g. breeze  -> load at startup instead of first request
# LOCALTTS_DATA=~/Projects/LocalTTS/data   # voices/ and outputs/ live here
# LOCALTTS_DEFAULT_ENGINE=kokoro   # used when a request names no voice and gives no instruction
# LOCALTTS_DEFAULT_KOKORO_VOICE=af_heart

# Engine venvs (the server never installs into them)
# LOCALTTS_BREEZE_PYTHON=~/venvs/breeze-next/bin/python
# LOCALTTS_KOKORO_PYTHON=~/venvs/kokoro/bin/python
# BREEZE_REPO=~/Projects/breeze-tts
# BREEZE_MODEL=~/models/breeze-tts-2
# LOCALTTS_BREEZE_FAST=depth_decoder,backbone_decode   # empty = plain eager (slower, no warmup)
# LOCALTTS_BREEZE_SEGMENT_CHARS=400                    # long text is split at sentences near this size
