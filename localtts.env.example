# Copied to ~/.config/localtts/localtts.env by install.sh. Uncomment to override;
# then `localtts restart`.

# LOCALTTS_HOST=127.0.0.1          # 0.0.0.0 to reach it from other machines (no auth!)
# LOCALTTS_PORT=5040
# LOCALTTS_KEEP_ALIVE_S=330       # idle keep-alive; must outlive the browser's (Firefox 115 s, Chrome 300 s)
# LOCALTTS_IDLE_UNLOAD_S=600       # unload an engine from the GPU after this long unused
# LOCALTTS_PRELOAD=                # e.g. breeze  -> load at startup instead of first request
# LOCALTTS_DATA=~/Projects/LocalTTS/data   # saved voices live in voices/ here
# LOCALTTS_OUTPUTS_DIR=~/Music/TTS         # generated audio, unless the request sets no_save
# LOCALTTS_DEFAULT_ENGINE=kokoro   # used when a request names no voice and gives no instruction
# LOCALTTS_DEFAULT_KOKORO_VOICE=af_heart

# AI-Enhance (any OpenAI-compatible chat endpoint; default is the DashLLM relay)
# LOCALTTS_LLM_URL=http://127.0.0.1:4000/v1
# LOCALTTS_LLM_MODEL=auto
# LOCALTTS_LLM_API_KEY=
# LOCALTTS_LLM_TIMEOUT_S=120

# Engines: by default everything below comes from ~/.config/tts-engines/engines.json
# (written by engines/setup.sh). Set a value here only to override it.
# Engine venvs (the server never installs into them)
# LOCALTTS_BREEZE_PYTHON=~/venvs/breeze-tts/bin/python
# BREEZE_DTYPE=bf16                                     # fp16 for NVIDIA older than sm_80
# BREEZE_DEVICE=cuda                                    # cuda (NVIDIA or AMD ROCm) | cpu
# LOCALTTS_KOKORO_PYTHON=~/venvs/kokoro/bin/python
# BREEZE_REPO=~/.local/share/tts-engines/breeze-tts
# BREEZE_MODEL=~/models/breeze-tts-2
# LOCALTTS_BREEZE_FAST=depth_decoder,backbone_decode   # empty = plain eager (slower, no warmup)
# LOCALTTS_BREEZE_SEGMENT_CHARS=400                    # long text is split at sentences near this size
